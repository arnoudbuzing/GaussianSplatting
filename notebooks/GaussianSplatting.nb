Cell[BoxData[
 DynamicModuleBox[{ArnoudBuzing`GaussianSplatting`Private`path$$ = 
  "/Users/arnoudb/Downloads/Cactus Garden/scene.ply"}, 
  TagBox[
   StyleBox[
    DynamicModuleBox[{ArnoudBuzing`GaussianSplatting`Private`mode$$ = "Splat",
      ArnoudBuzing`GaussianSplatting`Private`phi$$ = -1.2817698026646354`, 
     ArnoudBuzing`GaussianSplatting`Private`r$$ = 8.48, 
     ArnoudBuzing`GaussianSplatting`Private`theta$$ = -1.27, Typeset`show$$ = 
     True, Typeset`bookmarkList$$ = {}, Typeset`bookmarkMode$$ = "Menu", 
     Typeset`animator$$, Typeset`animvar$$ = 1, Typeset`name$$ = 
     "\"untitled\"", Typeset`specs$$ = {{{
        Hold[ArnoudBuzing`GaussianSplatting`Private`r$$], 3, "Distance"}, 0.1,
        10, ControlType -> Manipulator}, {{
        Hold[ArnoudBuzing`GaussianSplatting`Private`phi$$], 0, "Azimuth"}, -
       Pi, Pi, ControlType -> Manipulator}, {{
        Hold[ArnoudBuzing`GaussianSplatting`Private`theta$$], 0, 
        "Elevation"}, -1.4707963267948965`, 1.4707963267948965`, ControlType -> 
       Manipulator}, {{
        Hold[ArnoudBuzing`GaussianSplatting`Private`mode$$], "Splat", 
        "Mode"}, {"Splat", "Ellipse", "Point"}, ControlType -> SetterBar}}, 
     Typeset`size$$ = {400., {197.134033203125, 202.865966796875}}, 
     Typeset`update$$ = 0, Typeset`initDone$$, Typeset`skipInitDone$$ = True, 
     Typeset`keyframeActionsQ$$ = False, Typeset`keyframeList$$ = {}}, 
     DynamicBox[Manipulate`ManipulateBoxes[
      1, StandardForm, 
       "Variables" :> {
        ArnoudBuzing`GaussianSplatting`Private`mode$$ = "Splat", 
         ArnoudBuzing`GaussianSplatting`Private`phi$$ = 0, 
         ArnoudBuzing`GaussianSplatting`Private`r$$ = 3, 
         ArnoudBuzing`GaussianSplatting`Private`theta$$ = 0}, 
       "ControllerVariables" :> {}, 
       "OtherVariables" :> {
        Typeset`show$$, Typeset`bookmarkList$$, Typeset`bookmarkMode$$, 
         Typeset`animator$$, Typeset`animvar$$, Typeset`name$$, 
         Typeset`specs$$, Typeset`size$$, Typeset`update$$, 
         Typeset`initDone$$, Typeset`skipInitDone$$, 
         Typeset`keyframeActionsQ$$, Typeset`keyframeList$$}, "Body" :> 
       ArnoudBuzing`GaussianSplatting`PLYGaussianRender[
        ArnoudBuzing`GaussianSplatting`Private`path$$, 
         "Position" -> {
          ArnoudBuzing`GaussianSplatting`Private`r$$ 
           Cos[ArnoudBuzing`GaussianSplatting`Private`phi$$] 
           Cos[ArnoudBuzing`GaussianSplatting`Private`theta$$], 
           ArnoudBuzing`GaussianSplatting`Private`r$$ 
           Sin[ArnoudBuzing`GaussianSplatting`Private`theta$$], 
